APP_NAME=TravelApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travelapp
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TRAVEL_AGENCY_TIMEZONE=America/Bogota
TRAVEL_DEFAULT_CURRENCY=COP
TRAVEL_AGENCY_LOCALE=es_CO
TRAVEL_QUOTE_VALIDITY_HOURS=72
TRAVEL_ON_REQUEST_SLA_HOURS=24
TRAVEL_AGENT_SCOPE=own
TRAVEL_HIDE_MARGINS_FROM_AGENTS=true

LOG_SECURITY_DAYS=90
LOG_SUPPLIERS_DAYS=30
TRAVEL_COP_PRESENTATION_DECIMALS=0
TRAVEL_INFANT_MAX_AGE=1
TRAVEL_CHILD_MAX_AGE=11
TRAVEL_UI_SHOWCASE_ENABLED=false
TRAVEL_HEALTH_REQUESTS_PER_MINUTE=60
LOG_DAILY_DAYS=14
TRAVEL_USERS_PER_PAGE=20
TRAVEL_LOGO_DISK=public
TRAVEL_LOGO_MAX_KB=1024
TRAVEL_RNT_EXPIRY_WARNING_DAYS=60
TRAVEL_BRANCHES_PER_PAGE=20
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=5
AUTH_TWO_FACTOR_ATTEMPTS_PER_MINUTE=5
# Roles con 2FA obligatorio; vacío desactiva la exigencia (solo ambiente local de pruebas).
TRAVEL_TWO_FACTOR_REQUIRED_ROLES=system_admin,agency_owner,finance
TRAVEL_AUDIT_PER_PAGE=25
AUDIT_RETENTION_DAYS=3650
TRAVEL_WORKFLOW_PER_PAGE=20
TRAVEL_DEMO_PASSWORD=ViajesDemo2026
TRAVEL_CRM_PER_PAGE=20
TRAVEL_PII_HASH_KEY=
TRAVEL_PRIVACY_POLICY_VERSION=1.0
TRAVEL_PASSPORT_MIN_VALIDITY_MONTHS=6
TRAVEL_CRM_BOARD_COLUMN_SIZE=25
TRAVEL_CRM_MAX_LEAD_TRAVELERS=500
APP_PATH_PREFIX=
# Con la app publicada bajo una carpeta en Apache: ASSET_URL=/travelapp (CSS/JS de Vite).
ASSET_URL=
TRAVEL_SUPPLIERS_PER_PAGE=20
TRAVEL_SUPPLIER_RNT_WARNING_DAYS=30
TRAVEL_SUPPLIER_MAX_PAYMENT_DAYS=180
TRAVEL_FX_SPREAD_BASIS_POINTS=0
TRAVEL_PRICING_PER_PAGE=20
TRAVEL_MAX_QUERIES_PER_SCREEN=15
TRAVEL_CATALOG_PER_PAGE=20
TRAVEL_CATALOG_DEPARTURES_PER_PAGE=15
TRAVEL_CATALOG_MAX_DEPARTURE_CAPACITY=500
TRAVEL_CATALOG_MAX_PACKAGE_DAYS=30
TRM_SOURCE_URL=https://www.datos.gov.co/resource/32sa-8pi3.json
TRM_CONNECT_TIMEOUT=3
TRM_TIMEOUT=10
TRM_RETRIES=3
TRM_RETRY_SLEEP_MS=500
TRAVEL_QUOTE_NUMBER_PREFIX=COT-
TRAVEL_QUOTE_NUMBER_DIGITS=6
TRAVEL_QUOTE_MAX_OPTIONS=5
TRAVEL_QUOTE_MAX_PASSENGERS_PER_ITEM=50
TRAVEL_QUOTE_MAX_PASSENGER_AGE=120
TRAVEL_QUOTE_MAX_NIGHTS=90
TRAVEL_QUOTES_PER_PAGE=20
TRAVEL_QUOTE_LINK_REQUESTS_PER_MINUTE=30
TRAVEL_BOOKING_NUMBER_PREFIX=EXP-
TRAVEL_BOOKING_NUMBER_DIGITS=6
TRAVEL_BOOKINGS_PER_PAGE=20

# PDF (spatie/laravel-pdf + DomPDF, 100 % PHP). Sin recursos remotos: el logo se incrusta.
LARAVEL_PDF_DRIVER=dompdf
LARAVEL_PDF_DOMPDF_REMOTE_ENABLED=false

# Búsqueda multi-proveedor (ADR-0006). Proveedores: fake, duffel (vuelos); fake, liteapi (hoteles).
TRAVEL_FLIGHT_PROVIDERS=fake
TRAVEL_HOTEL_PROVIDERS=fake
TRAVEL_SEARCH_CACHE_TTL=600
TRAVEL_SEARCH_BREAKER_FAILURES=3
TRAVEL_SEARCH_BREAKER_COOLDOWN=120
TRAVEL_SEARCH_MAX_PASSENGERS=9
TRAVEL_SEARCH_MAX_NIGHTS=30
TRAVEL_SEARCH_AUTOCOMPLETE_MIN_CHARS=2
TRAVEL_SEARCH_AUTOCOMPLETE_LIMIT=8

# Pagos (PCI DSS SAQ-A: solo links/tokens de la pasarela)
TRAVEL_PAYMENT_GATEWAY=fake
TRAVEL_BALANCE_DUE_DAYS_BEFORE=15
TRAVEL_PAYMENT_LINK_TTL_HOURS=48
TRAVEL_PAYMENT_WEBHOOKS_PER_MINUTE=120
# Secreto con el que la pasarela simulada firma sus webhooks (genera uno: php -r "echo bin2hex(random_bytes(32));")
FAKE_PAYMENTS_WEBHOOK_SECRET=

# Finanzas
TRAVEL_PREPAID_DAYS_BEFORE_SERVICE=7
TRAVEL_FINANCE_PER_PAGE=25
TRAVEL_RECONCILIATION_WINDOW_DAYS=3
TRAVEL_STATEMENT_MAX_KB=2048
TRAVEL_INVOICE_PREFIX=FV-
TRAVEL_CREDIT_NOTE_PREFIX=NC-
TRAVEL_DEBIT_NOTE_PREFIX=ND-
TRAVEL_E_INVOICING_PROVIDER=internal
TRAVEL_E_INVOICING_TRIES=5
TRAVEL_INVOICING_READY_LIMIT=100
TRAVEL_INVOICING_PER_PAGE=25
TRAVEL_CASH_HISTORY_SIZE=10
